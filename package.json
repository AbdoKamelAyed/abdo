{
  "name": "abdo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "ABDO — a personal digital publication and knowledge platform. Phase 5: foundation, admin dashboard, editorial studio, customization and content discovery. Zero runtime dependencies.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node src/build.mjs",
    "validate": "node src/build.mjs --validate-only",
    "build:local": "node src/build.mjs --site-url http://localhost:4173",
    "serve": "node tools/serve.mjs",
    "dev": "npm run build:local && npm run serve",
    "test": "node --test \"tests/**/*.test.mjs\"",
    "new-id": "node tools/new-id.mjs",
    "test:e2e": "node tests/e2e/admin.e2e.mjs",
    "test:e2e:search": "node tests/e2e/search.e2e.mjs",
    "test:e2e:discovery": "node tests/e2e/discovery-admin.e2e.mjs",
    "build:no-admin": "node src/build.mjs --no-admin"
  }
}
