{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://abdo.invalid/schemas/media.schema.json",
  "title": "MediaAsset collection",
  "description": "Registry of media files. Files live in content/media/files/ and are copied to /media/ on build. Phase 1 supports local files only; external storage for large media (Cloudflare R2) is planned for Phase 2 (see docs/roadmap.md).",
  "type": "object",
  "required": ["schemaVersion", "items"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "$ref": "common.schema.json#/$defs/schemaVersion" },
    "items": { "type": "array", "items": { "$ref": "#/$defs/asset" } }
  },
  "$defs": {
    "asset": {
      "type": "object",
      "required": ["id", "status", "type", "file", "mimeType", "alt", "createdAt", "updatedAt"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "common.schema.json#/$defs/id_media" },
        "status": { "enum": ["active", "archived"] },
        "type": { "enum": ["image", "video", "audio", "document"] },
        "file": { "description": "Path relative to content/media/files/, no leading slash, no '..'.", "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*(/[A-Za-z0-9][A-Za-z0-9._-]*)*$" },
        "mimeType": { "type": "string", "pattern": "^[a-z]+/[a-z0-9.+-]+$" },
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 },
        "alt": { "$ref": "common.schema.json#/$defs/localized" },
        "caption": { "$ref": "common.schema.json#/$defs/localized" },
        "credit": { "type": "string", "minLength": 1 },
        "focal": {
          "description": "The part of the image that must stay visible when a frame crops it, as percentages from the top-left corner. Omitted means the centre.",
          "type": "object",
          "required": ["x", "y"],
          "additionalProperties": false,
          "properties": {
            "x": { "type": "integer", "minimum": 0, "maximum": 100 },
            "y": { "type": "integer", "minimum": 0, "maximum": 100 }
          }
        },
        "sample": { "type": "boolean" },
        "createdAt": { "$ref": "common.schema.json#/$defs/dateTime" },
        "updatedAt": { "$ref": "common.schema.json#/$defs/dateTime" }
      }
    }
  }
}
